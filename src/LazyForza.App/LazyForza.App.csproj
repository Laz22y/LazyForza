<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.5.3</Version>
    <ReleaseNameZh>Radio Check</ReleaseNameZh>
    <ReleaseNameEn>Radio Check</ReleaseNameEn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\LazyForza.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="ReleaseName.zh-Hans" Value="$(ReleaseNameZh)" />
    <AssemblyMetadata Include="ReleaseName.en" Value="$(ReleaseNameEn)" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\LazyForza.png" />
    <Resource Include="Assets\LazyForzaWordmark.png" />
    <EmbeddedResource Include="Localization\*.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LazyForza.Speech\LazyForza.Speech.csproj" />
    <ProjectReference Include="..\LazyForza.Domain\LazyForza.Domain.csproj" />
    <ProjectReference Include="..\LazyForza.Telemetry\LazyForza.Telemetry.csproj" />
    <ProjectReference Include="..\LazyForza.Analysis\LazyForza.Analysis.csproj" />
    <ProjectReference Include="..\LazyForza.Storage\LazyForza.Storage.csproj" />
    <ProjectReference Include="..\LazyForza.Update\LazyForza.Update.csproj" />
    <ProjectReference Include="..\LazyForza.Modules.Abstractions\LazyForza.Modules.Abstractions.csproj" />
    <ProjectReference Include="..\LazyForza.Modules.Dashboard\LazyForza.Modules.Dashboard.csproj" />
    <ProjectReference Include="..\LazyForza.Modules.LapAnalysis\LazyForza.Modules.LapAnalysis.csproj" />
    <ProjectReference Include="..\LazyForza.Modules.EstateRace\LazyForza.Modules.EstateRace.csproj" />
    <ProjectReference Include="..\LazyForza.Overlay\LazyForza.Overlay.csproj" />
  </ItemGroup>
</Project>
