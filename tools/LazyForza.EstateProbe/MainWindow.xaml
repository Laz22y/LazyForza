<Window x:Class="LazyForza.EstateProbe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LazyForza 地产坐标验证工具" Width="1180" Height="850"
        MinWidth="980" MinHeight="720" WindowStartupLocation="CenterScreen"
        Background="#0B1018" Foreground="#EDF5FF">
    <Grid Margin="20" Background="#0B1018">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="地产坐标验证工具" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="只读取 FH6 官方 UDP；用于比较房主、访客、重新进入和地图副本的坐标关系。"
                           Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="#172334" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="14,8" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="未监听" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <GroupBox Grid.Row="1" Header="采集会话">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="会话名称" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                    <TextBox x:Name="SessionNameBox" Text="地产坐标验证" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="身份/场景" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                    <ComboBox x:Name="SessionRoleBox" SelectedIndex="0">
                        <ComboBoxItem Content="房主首次进入" />
                        <ComboBoxItem Content="房主重新进入" />
                        <ComboBoxItem Content="访客" />
                        <ComboBoxItem Content="下载副本" />
                        <ComboBoxItem Content="其他" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="监听地址" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                    <TextBox x:Name="AddressBox" Text="127.0.0.1" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,12,0">
                    <TextBlock Text="端口" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                    <TextBox x:Name="PortBox" Text="2299" />
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="StartButton" Content="开始新会话" Background="#146A65" Click="StartButton_Click" />
                    <Button x:Name="StopButton" Content="停止" IsEnabled="False" Click="StopButton_Click" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="实时 Data Out">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="1.6*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="包率 / 有效包" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="PacketText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="位置 X / Y / Z" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="PositionText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="速度 / 朝向" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="MotionText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="IsRaceOn / RacePosition" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="RaceStateText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="CurrentLap / RaceTime / LapNumber" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="TimerText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="0.95*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="标记点采样" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MarkerNameBox" Text="起点" ToolTip="两台电脑必须使用完全相同的标记名称" />
                        <Button Grid.Column="1" Content="采样最近 1 秒" Background="#146A65" Margin="10,0,8,0"
                                Click="CaptureMarkerButton_Click" />
                        <Button Grid.Column="2" Content="删除所选" Margin="0" Click="DeleteMarkerButton_Click" />
                    </Grid>
                    <DataGrid x:Name="MarkerGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="#0F1722" Foreground="{StaticResource TextBrush}"
                              BorderBrush="{StaticResource BorderBrush}" GridLinesVisibility="Horizontal"
                              RowBackground="#101925" AlternatingRowBackground="#142030"
                              HeadersVisibility="Column" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="1.2*" />
                            <DataGridTextColumn Header="X" Binding="{Binding X, StringFormat=F3}" Width="*" />
                            <DataGridTextColumn Header="Y" Binding="{Binding Y, StringFormat=F3}" Width="*" />
                            <DataGridTextColumn Header="Z" Binding="{Binding Z, StringFormat=F3}" Width="*" />
                            <DataGridTextColumn Header="离散" Binding="{Binding SpreadMeters, StringFormat={}{0:F3} m}" Width="*" />
                            <DataGridTextColumn Header="样本" Binding="{Binding SampleCount}" Width="0.7*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}"
                               Text="车辆停稳后采样。建议起点、远端弯角和第三个非共线位置至少各采一次。" TextWrapping="Wrap" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="保存与比较" Margin="0">
                <TabControl Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}">
                    <TabItem Header="保存会话">
                        <StackPanel Margin="12">
                            <TextBlock Text="备注" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" />
                            <TextBox x:Name="NotesBox" Height="130" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="记录地产所有者、进入方式、同一实体标记位置及异常现象。" />
                            <Button Content="保存 .lfzestateprobe.json" Background="#146A65"
                                    HorizontalAlignment="Left" Margin="0,12,0,0" Click="SaveSessionButton_Click" />
                            <TextBlock x:Name="SessionSummaryText" Margin="0,14,0,0" Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" Text="尚未开始采集。" />
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="比较两份会话">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="ReferencePathBox" ToolTip="通常选择房主首次进入会话" />
                                <Button Grid.Column="1" Content="参考会话…" Margin="8,0,0,0" Click="BrowseReferenceButton_Click" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="CandidatePathBox" ToolTip="选择访客、重新进入或下载副本会话" />
                                <Button Grid.Column="1" Content="待比较会话…" Margin="8,0,0,0" Click="BrowseCandidateButton_Click" />
                            </Grid>
                            <Button Grid.Row="2" Content="比较坐标关系" Background="#146A65" HorizontalAlignment="Left"
                                    Margin="0,10,0,10" Click="CompareButton_Click" />
                            <TextBox x:Name="ComparisonResultBox" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                                     Text="选择两份会话文件后进行比较。" />
                        </Grid>
                    </TabItem>
                </TabControl>
            </GroupBox>
        </Grid>

        <TextBlock Grid.Row="4" Margin="0,13,0,0" Foreground="{StaticResource MutedBrush}"
                   Text="注意：同一 UDP 端口不能同时由 LazyForza 主程序和本工具监听。实测时请退出主程序，或给本工具配置另一个 FH6 Data Out 端口。" />
    </Grid>
</Window>
